# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# CORS Settings
CORS_ORIGIN=http://localhost:5173

# Payment Gateway Secrets (Razorpay Sandbox / Production)
PAYMENT_GATEWAY_KEY=rzp_test_your_key_id
PAYMENT_GATEWAY_SECRET=your_razorpay_secret_key
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# Messaging & Email Credentials
SMS_API_KEY=your_sms_provider_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@eseva.gov.in
SMTP_PASS=your_smtp_app_password
